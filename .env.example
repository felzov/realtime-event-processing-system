# Copy to `.env` to override settings locally (`.env` is git-ignored). Every line is optional: the
# values below are the defaults from src/event_pipeline/config.py, for the Compose services
# (`make up`). Environment variables take precedence over `.env`.

# Kafka (plaintext, local only)
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
EVENTS_TOPIC=orders.placed.v1
EVENTS_TOPIC_PARTITIONS=6
EVENTS_TOPIC_REPLICATION_FACTOR=1
KAFKA_ADMIN_TIMEOUT_S=10.0
KAFKA_DELIVERY_TIMEOUT_MS=5000
# Must be at least KAFKA_DELIVERY_TIMEOUT_MS + 2000 ms.
PUBLISH_BACKSTOP_S=10.0
READY_TIMEOUT_S=2.0
PUBLISHER_CLOSE_TIMEOUT_S=5.0

# PostgreSQL. Must start with postgresql+psycopg://. The password here is the fixed local
# development password from compose.yaml; put a real one only in `.env`, never in this file.
DATABASE_URL=postgresql+psycopg://event_pipeline:event_pipeline_local@127.0.0.1:5432/event_pipeline
# Whole seconds, at least 2.
DB_CONNECT_TIMEOUT_S=5
DB_STATEMENT_TIMEOUT_MS=5000
DB_POOL_TIMEOUT_S=5.0

# Consumer (`make consumer`)
CONSUMER_GROUP_ID=event-pipeline-aggregator
CONSUMER_POLL_TIMEOUT_S=1.0
# At least 45000, and at least
# 2 x ((DB_POOL_TIMEOUT_S + DB_CONNECT_TIMEOUT_S) x 1000 + 4 x DB_STATEMENT_TIMEOUT_MS).
CONSUMER_MAX_POLL_INTERVAL_MS=300000
# Longer than CONSUMER_POLL_TIMEOUT_S.
CONSUMER_CLOSE_TIMEOUT_S=10.0
